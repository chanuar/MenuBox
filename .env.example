# Copia este archivo como `.env` para desarrollo local y configura las mismas
# variables en Cloudflare. La clave publicable es pública por diseño: RLS limita
# las operaciones del navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# No añadas UUID de administradores, una service-role key, access tokens ni
# contraseñas de base de datos. La service-role pertenece solo al scraper.
# Se conserva VITE_SUPABASE_ANON_KEY por compatibilidad con proyectos antiguos.
